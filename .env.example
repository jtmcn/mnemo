# Mnemo Environment Variables
# Copy this file to .env and fill in your values.
# Mnemo does not load .env automatically — use direnv, dotenv, or source it manually.

# ── Embeddings (required for semantic search) ───────────────────────────────
# Any OpenAI-compatible endpoint: mnemo POSTs to {BASE_URL}/embeddings.
# Without these, add/search still work — keyword (FTS5) only.
#
#   OpenAI:  https://api.openai.com/v1        text-embedding-3-small
#   Voyage:  https://api.voyageai.com/v1      voyage-3
#   Ollama:  http://localhost:11434/v1        nomic-embed-text   (no key needed)
MNEMO_EMBED_BASE_URL=https://api.openai.com/v1
MNEMO_EMBED_API_KEY=your-api-key
# MNEMO_EMBED_MODEL=text-embedding-3-small

# Inputs longer than this are truncated before embedding — code/math/table
# blocks are never split, so a long listing can exceed any provider's limit.
# Default 8192 (OpenAI text-embedding-3). Raise it for a longer-context model.
# MNEMO_EMBED_MAX_TOKENS=8192

# Switching models changes the vector dimension. ChromaDB locks dimension on
# first insert, so re-embed from scratch: rm -rf ~/.mnemo/chroma && mnemo reindex

# ── Logging ─────────────────────────────────────────────────────────────────
# Log level for the MCP server. Valid values: DEBUG, INFO, WARNING, ERROR
# Default: INFO
# Note: This affects the MCP server only, not CLI output (which uses rich.Console).
# MNEMO_LOG_LEVEL=INFO

# ── Data Directories (currently hard-coded, not configurable via env) ────────
# SQLite database:  ~/.mnemo/mnemo.db
# ChromaDB vectors: ~/.mnemo/chroma
# These directories are created automatically on first run.
