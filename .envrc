# Activate uv's .venv rather than a separate direnv-managed one.
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

# Load machine-local secrets (export VAR=... format) when present.
source_env ~/.secrets exists

# Semantic search needs an OpenAI-compatible embeddings endpoint (see .env.example).
# .env is gitignored; uncomment to load it automatically on cd.
dotenv_if_exists .env
